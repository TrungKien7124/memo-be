# Copy to `.env` (local runserver) or merge into `.env.docker` (Compose).
# See comments in those files for host vs Docker DB/Redis ports.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=memo_db
DB_USER=memo_user
DB_PASSWORD=memo_password
DB_HOST=127.0.0.1
DB_PORT=5433

REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Chat LLM: local Ollama | RAG embed: Gemini gemini-embedding-001 only (pgvector)
AI_PROVIDER=local
AI_LOCAL_LLM_URL=http://127.0.0.1:11434
AI_LOCAL_LLM_MODEL=llama3
AI_LOCAL_STT_URL=http://127.0.0.1:8081
# Current phase default: disable auto STT and require manual transcript for uploaded video lessons.
LESSON_AUTO_TRANSCRIBE_ENABLED=false
OPENAI_API_KEY=

AI_RAG_ENABLED=true
AI_VECTOR_STORE=pgvector
AI_GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_KEY=
