# ============================================================
# Environment Variables – copy to .env and adjust for your setup
# ============================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL (primary database) ────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=memo_db
DB_USER=memo_user
DB_PASSWORD=memo_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI Provider ──────────────────────────────────────────────
# Switch between "openai" and "local"
AI_PROVIDER=openai
# AI_STT_PROVIDER=openai          # override STT provider independently
# AI_TTS_PROVIDER=openai          # override TTS provider independently

# External API keys (when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
# AI_LLM_MODEL=gpt-3.5-turbo     # override default LLM model
# AI_STT_MODEL=whisper-1          # override default STT model
# AI_TTS_MODEL=tts-1              # override default TTS model

# Local AI endpoints (when AI_PROVIDER=local)
# AI_LOCAL_LLM_URL=http://localhost:11434    # vLLM / Ollama / llama.cpp
# AI_LOCAL_LLM_MODEL=llama3
# AI_LOCAL_LLM_API_KEY=
# AI_LOCAL_LLM_TIMEOUT=60
# AI_LOCAL_STT_URL=http://localhost:8081     # faster-whisper-server
# AI_LOCAL_STT_MODEL=whisper-large-v3
# AI_LOCAL_TTS_URL=http://localhost:8082     # Coqui TTS / Piper

# RAG (Retrieval-Augmented Generation)
# AI_RAG_ENABLED=false
# AI_VECTOR_STORE=chroma
# AI_VECTOR_STORE_PATH=./data/chroma
# AI_VECTOR_COLLECTION=memo_rag
# AI_RAG_TOP_K=5

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
