# ============================================================
# Docker Compose Environment – copy to .env.docker and adjust
# ============================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-docker-dev-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=memo_db
POSTGRES_USER=memo_user
POSTGRES_PASSWORD=memo_password

DB_ENGINE=django.db.backends.postgresql
DB_NAME=memo_db
DB_USER=memo_user
DB_PASSWORD=memo_password
DB_HOST=db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI Provider ──────────────────────────────────────────────
AI_PROVIDER=local
AI_STT_PROVIDER=openai
AI_TTS_PROVIDER=openai

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Local AI (uncomment when AI_PROVIDER=local)
AI_LOCAL_LLM_URL=http://host.docker.internal:11434
AI_LOCAL_LLM_MODEL=qwen2.5:3b
# AI_LOCAL_STT_URL=http://local-stt:8081
# AI_LOCAL_TTS_URL=http://local-tts:8082

# RAG
AI_RAG_ENABLED=true
# AI_VECTOR_STORE=chroma
AI_VECTOR_STORE_PATH=/app/data/chroma
# AI_VECTOR_COLLECTION=memo_rag
# AI_RAG_TOP_K=5
AI_OLLAMA_EMBED_URL=http://host.docker.internal:11434
AI_OLLAMA_EMBED_MODEL=nomic-embed-text
# AI_OLLAMA_EMBED_TIMEOUT=30

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Port mapping (host ports) ───────────────────────────────
DB_PORT_EXPOSE=5433
REDIS_PORT_EXPOSE=6379
WEB_PORT=8000
WS_PORT=8001
