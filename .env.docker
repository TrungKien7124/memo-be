# =============================================================================
# Memo BE – Docker Compose (web, celery, daphne, db, redis đọc file này)
# =============================================================================
# Không đặt API key thật vào repo: copy sang máy bạn và điền key, hoặc dùng
# override file riêng. File .env (ngoài Docker) dùng khi chạy manage.py local.
# =============================================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-docker-dev-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# ── PostgreSQL (service `db` trong compose) ─────────────────
POSTGRES_DB=memo_db
POSTGRES_USER=memo_user
POSTGRES_PASSWORD=memo_password

DB_ENGINE=django.db.backends.postgresql
DB_NAME=memo_db
DB_USER=memo_user
DB_PASSWORD=memo_password
DB_HOST=db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# AI – Chat: LLM local (Ollama trên máy host qua host.docker.internal)
# =============================================================================
AI_PROVIDER=local
AI_LOCAL_LLM_URL=http://host.docker.internal:11434
AI_LOCAL_LLM_MODEL=llama3
AI_LOCAL_LLM_TIMEOUT=60
AI_STT_PROVIDER=local
AI_LOCAL_STT_URL=http://host.docker.internal:8081
AI_LOCAL_STT_MODEL=small
AI_LOCAL_STT_TIMEOUT=60
LESSON_AUTO_TRANSCRIBE_ENABLED=false

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# STT/TTS qua OpenAI (tùy chọn)
# AI_STT_PROVIDER=openai
# AI_TTS_PROVIDER=openai
# AI_STT_MODEL=whisper-1
# AI_TTS_MODEL=tts-1

# =============================================================================
# RAG – chỉ gemini-embedding-001 + pgvector (không dùng Ollama/Chroma embed).
# Cần GEMINI_API_KEY (hoặc GOOGLE_API_KEY).
# =============================================================================
AI_RAG_ENABLED=true
AI_VECTOR_STORE=pgvector
AI_RAG_TOP_K=5
AI_GEMINI_EMBED_MODEL=gemini-embedding-001
AI_GEMINI_EMBED_DIMENSIONS=768
AI_GEMINI_EMBED_TIMEOUT=60
AI_GEMINI_EMBED_BATCH_SIZE=16

GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ── Port mapping (host) – chỉ compose đọc ────────────────────
DB_PORT_EXPOSE=5433
REDIS_PORT_EXPOSE=6380
WEB_PORT=8000
WS_PORT=8001
