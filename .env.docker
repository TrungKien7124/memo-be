# ============================================================
# Docker Compose Environment – copy to .env.docker and adjust
# ============================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-docker-dev-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=memo_db
POSTGRES_USER=memo_user
POSTGRES_PASSWORD=memo_password

DB_ENGINE=django.db.backends.postgresql
DB_NAME=memo_db
DB_USER=memo_user
DB_PASSWORD=memo_password
DB_HOST=db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI APIs (fill in your keys) ─────────────────────────────
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Port mapping (host ports) ───────────────────────────────
# DB_PORT is the internal container port (always 5432).
# DB_PORT_EXPOSE is the host port you access from your machine.
DB_PORT_EXPOSE=5433
REDIS_PORT_EXPOSE=6379
WEB_PORT=8000
WS_PORT=8001
